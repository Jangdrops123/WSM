# --- Backup & Restore Database (opsional) ---
# Folder biner PostgreSQL bila pg_dump/psql tidak ada di PATH (Windows contoh:
# C:\Program Files\PostgreSQL8in).
# PG_BIN_DIR=
# Hook penyimpanan luar: perintah yang dijalankan tiap backup selesai dengan
# path berkas sebagai argumen (mis. skrip upload ke Google Drive / S3).
# Kegagalan hook hanya dicatat, tidak menggagalkan backup lokal.
# BACKUP_CLOUD_CMD=
